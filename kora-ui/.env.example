# Local OpenAI-compatible Qwen text endpoint (loopback only)
ADA_LLM_BASE_URL=http://127.0.0.1:8081/v1
ADA_LLM_MODEL=/srv/homelab/models/Qwen_Qwen3-1.7B-Q4_K_M.gguf

# Optional experimental Hermes ACP conversational engine; local Qwen remains default.
# ACP sessions get temporary MCP tools for read-only ADA skill search/read only.
# Effectful local ADA tools are still not exposed to Hermes.
# Optional Python executable for that bridge; defaults to Hermes' MCP-enabled venv.
# ADA_HERMES_PYTHON=~/.hermes/hermes-agent/venv/bin/python
# Prompts are shown in ADA's approval UI before sending to Hermes' configured provider.
# ACP does not bridge ADA's local CAD/Kasa/printer/Taskwarrior/camera actions yet.
# ADA_CONVERSATION_ENGINE=hermes-acp

# Local model/data assets live outside the repository
ADA_DATA_DIR=~/.local/share/ada-v2-local
# Optional: set to an external folder for new projects; omit to keep existing repo/projects data.
# ADA_PROJECT_ROOT=~/.local/share/ada-v2-local/workspace
# Optional local transcript persistence; disabled unless explicitly opted in.
ADA_PERSIST_CHAT_HISTORY=0
ADA_VLM_PORT=8082
ADA_PIPER_BIN=~/.local/bin/piper
